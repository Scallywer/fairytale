# --- Required ---

# Admin login password. Must be set for /admin to work.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# HMAC key for signing admin session cookies, rater_id cookies, and
# captcha tokens. Keep this separate from ADMIN_PASSWORD so the two
# can be rotated independently. 32+ characters recommended.
#
# Generate with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-openssl-rand-hex-32

# --- Recommended ---

# Public base URL — used for canonical links, sitemap, OG tags, etc.
NEXT_PUBLIC_SITE_URL=https://pricezalakunoc.hr

# Set to "true" only when running behind a known reverse proxy that
# scrubs incoming X-Forwarded-For headers. Otherwise rate limits fall
# back to a single shared "untrusted" bucket.
TRUST_PROXY=false

# --- Optional ---

# Enable debug logging (server + client).
# DEBUG=true
# NEXT_PUBLIC_DEBUG=true

# Emit logs as JSON. Recommended in production for log aggregators.
LOG_JSON=1

# Used by scripts under scripts/ to generate images via OpenAI DALL·E.
# Not needed at runtime.
# OPENAI_API_KEY=sk-...
